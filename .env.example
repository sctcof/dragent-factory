# ============================================================
# Data-RAG-Agent Factory — 本地 / 私有化部署配置模板
# 用法：cp .env.example .env 后按需修改
# ============================================================

# ---------- 元数据仓储 ----------
# json: 使用 local_data/metadata.json（最轻量，无需 Postgres）
# postgres: 使用 PostgreSQL（目标架构，Compose 默认）
DRAGENT_STORE=postgres
PROJECT_ID=p_local

# ---------- PostgreSQL + pgvector ----------
POSTGRES_DB=dragent
POSTGRES_USER=dragent
POSTGRES_PASSWORD=dragent
POSTGRES_PORT=5432
# 本机进程连宿主机 Postgres 用 localhost；Compose 内 API 服务用主机名 postgres
DATABASE_URL=postgresql+psycopg2://dragent:dragent@localhost:5432/dragent

# ---------- Redis（RAG 缓存 / 任务进度，失败自动降级） ----------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ---------- Neo4j（知识图谱，失败回退内存图） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dragent-neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- 对象存储（当前文件仍落 local_data/objects；MinIO 供后续切换） ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=dragent
MINIO_SECRET_KEY=dragent-secret
MINIO_BUCKET=dragent
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- RAG ----------
# local: 本地关键词检索（默认可用）
# ragflow: 需独立启动 RAGFlow，并填写下方地址与 Key
VECTOR_BACKEND=local
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=30

# ---------- 可选：外部 LLM（未配置时 Agent 使用本地启发式） ----------
# 兼容 OpenAI Chat Completions 协议（DeepSeek / OpenRouter / OpenAI / 自建网关均可）
# 推荐在 Web「模型管理」页按模型单独配置；页面配置优先于此处环境变量
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-xxxxxxxx
# OpenRouter 示例：
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-xxxxxxxx
LLM_BASE_URL=
LLM_API_KEY=
# 或使用 OPENAI_BASE_URL / OPENAI_API_KEY
# OpenRouter 可选站点标识
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=dragent-factory

# ---------- Web / API 地址 ----------
# 浏览器访问的 API 根地址；Docker / 远程部署时改为实际可达地址
NEXT_PUBLIC_API_BASE=http://localhost:8000
