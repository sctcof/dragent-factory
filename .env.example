# Storage backend: json (local MVP) | postgres (target)
DRAGENT_STORE=postgres

# PostgreSQL + pgvector
DATABASE_URL=postgresql+psycopg2://dragent:dragent@localhost:5432/dragent

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dragent-neo4j

# Object storage (local path by default; MinIO optional)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=dragent
MINIO_SECRET_KEY=dragent-secret
MINIO_BUCKET=dragent

# RAG backend: local | ragflow
VECTOR_BACKEND=local
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=30

# API / Web
NEXT_PUBLIC_API_BASE=http://localhost:8000
PROJECT_ID=p_local
